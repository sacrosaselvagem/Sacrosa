# =====================================================================================
# Atendimento Rosa Selvagem na VPS: configuracao
# O instalar.sh copia este arquivo para ".env" e preenche sozinho os segredos que estao vazios
# (SECRET_KEY_BASE, senhas do banco e do Redis, FB_VERIFY_TOKEN, IG_VERIFY_TOKEN...).
# O .env fica so na VPS, com permissao 600. Nunca mande este arquivo preenchido para ninguem.
# Depois de mudar algo aqui:  cd /opt/rosa/codigo/deploy/vps && docker compose up -d
# =====================================================================================

# ---------- Enderecos (os dois precisam de um registro A no DNS apontando para o IP da VPS) ----------
# Tela de atendimento da equipe (a nossa tela).
ATENDIMENTO_HOST=atendimento.rosaselvagemoficial.com.br
# Chatwoot: painel, webhooks da Meta/WhatsApp/Telegram, widget do site e central de ajuda.
CHAT_HOST=chat.rosaselvagemoficial.com.br
# E-mail para o Let's Encrypt avisar sobre o certificado HTTPS (avisos de vencimento).
ACME_EMAIL=renato@rosaselvagemoficial.com.br
# O FRONTEND_URL do Chatwoot sai sozinho como https://CHAT_HOST (veja docker-compose.yml). Nao precisa preencher.

# Pasta da VPS com config, logs, dados do Cerebro e backups.
ROSA_DIR=/opt/rosa

# ---------- Chatwoot ----------
# Chave secreta do Chatwoot (128 caracteres). Gerada pelo instalar.sh. Se trocar, todo mundo precisa entrar de novo.
SECRET_KEY_BASE=
# Ninguem de fora cria conta sozinho. A equipe entra por convite (tela Usuarios). Deixe false.
ENABLE_ACCOUNT_SIGNUP=false

# ---------- Banco de dados e fila (so na rede interna do Docker) ----------
# Senha do Postgres. Gerada pelo instalar.sh. Nao troque depois que o banco foi criado.
POSTGRES_PASSWORD=
# Senha do Redis. Gerada pelo instalar.sh.
REDIS_PASSWORD=

# ---------- IA do SAC ----------
# Chave da API da Anthropic (console.anthropic.com > API Keys). A IA do SAC e a Central de Ajuda usam o Claude por ela.
# Sem chave, a tela funciona, mas a IA nao responde. Comece com um limite de gasto mensal no console.
ANTHROPIC_API_KEY=
# Versao do Claude Code dentro da imagem (latest = a mais nova no momento do build).
CLAUDE_CODE_VERSION=latest

# ---------- Messenger e Instagram (app da Meta) ----------
# Do app em developers.facebook.com > Configuracoes do app > Basico: "ID do aplicativo" e "Chave secreta".
FB_APP_ID=
FB_APP_SECRET=
# Senhas que voce inventa e cola na Meta ao cadastrar o webhook. Geradas pelo instalar.sh.
#   Messenger: URL https://CHAT_HOST/bot               com FB_VERIFY_TOKEN
#   Instagram: URL https://CHAT_HOST/webhooks/instagram com IG_VERIFY_TOKEN (ou INSTAGRAM_VERIFY_TOKEN)
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
FACEBOOK_API_VERSION=v22.0
# Instagram pelo "Login do Instagram" (jeito novo do Chatwoot 4, sem precisar de pagina do Facebook).
# Do mesmo app da Meta, produto "Instagram" > "Configurar a API com login do Instagram".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v22.0

# ---------- WhatsApp Cloud API ----------
# Nao vai aqui. O WhatsApp e configurado dentro do Chatwoot, em cada caixa de entrada:
# Configuracoes > Caixas de entrada > Adicionar > WhatsApp > WhatsApp Cloud
# (numero, Phone number ID, WhatsApp Business Account ID e o token permanente). Veja o GUIA.md.

# ---------- Telegram ----------
# Tambem nao vai aqui: o token do BotFather e colado na caixa do Telegram, dentro do Chatwoot.

# ---------- E-mail (opcional) ----------
# Sem SMTP tudo funciona (os convites da equipe saem com senha provisoria pela tela Usuarios).
# Com SMTP, o Chatwoot manda "esqueci a senha" e avisos por e-mail.
MAILER_SENDER_EMAIL=Rosa Selvagem <nao-responda@rosaselvagemoficial.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=rosaselvagemoficial.com.br
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
